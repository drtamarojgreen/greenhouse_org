{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server/**",
          "views/**",
          "public/**",
          "js/**",
          "css/**",
          "images/**",
          "endpoints/**",
          "assets/**",
          "docs/**"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "app.js" }]
}