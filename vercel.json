{
  "version": 2,
  "installCommand": "yarn install",
  "buildCommand": "yarn build",
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server/**",
          "views/**",
          "js/**",
          "css/**",
          "docs/**",
          "endpoints/**",
          "assets/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "app.js" }
  ]
}