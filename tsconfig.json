{
  "compilerOptions": {
    "target": "ES6",
    "module": "None",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".",
    "rootDir": "."
  },
  "include": [
    "js/**/*.ts",
    "tests/unit/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
